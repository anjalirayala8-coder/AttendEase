<% request.setAttribute("pageTitle", "Attendance reports"); request.setAttribute("activePage", "reports"); %>
<%@ include file="_layout-top.jsp" %>
<section class="welcome-row"><div><div class="eyebrow purple">INSIGHTS & PERFORMANCE</div><h1>Attendance reports</h1><p class="muted">Review each student's attendance record and identify students below 75%.</p></div><button class="btn btn-soft" onclick="window.print()" type="button">⇩ Print report</button></section>
<section class="panel table-panel"><div class="table-toolbar"><div><h3>Student attendance summary <span class="count-pill">${reports.size()}</span></h3><p class="muted">Percentage is calculated from dates that have been marked.</p></div></div>
<div class="table-scroll"><table><thead><tr><th>STUDENT</th><th>ROLL NUMBER</th><th>CLASSES ATTENDED</th><th>CLASSES MARKED</th><th>ATTENDANCE</th><th>STATUS</th></tr></thead><tbody>
<% java.util.List<java.util.Map<String,Object>> reports = (java.util.List<java.util.Map<String,Object>>) request.getAttribute("reports"); if (reports.isEmpty()) { %><tr><td colspan="6" class="empty-state">No report data available.</td></tr><% } else { for (java.util.Map<String,Object> r : reports) { Object pctObj = r.get("pct"); Double pct = pctObj == null ? null : (Double)pctObj; String name=String.valueOf(r.get("name")); %>
<tr><td><div class="student-cell"><span class="student-avatar"><%= name.isEmpty() ? "S" : name.substring(0,1).toUpperCase() %></span><strong><%= com.attendease.util.HtmlUtil.escape(name) %></strong></div></td><td><span class="roll-pill"><%= com.attendease.util.HtmlUtil.escape(String.valueOf(r.get("rollNo"))) %></span></td><td><%= r.get("attended") %></td><td><%= r.get("marked") %></td><td><% if (pct == null) { %><span class="muted">Not marked</span><% } else { %><div class="percent-cell"><div class="mini-track"><span style="width:<%= Math.max(0,Math.min(100,pct)) %>%"></span></div><strong><%= String.format(java.util.Locale.US, "%.1f", pct) %>%</strong></div><% } %></td><td><% if (pct == null) { %><span class="status-badge neutral">No data</span><% } else if (pct < 75) { %><span class="status-badge warning">Below 75%</span><% } else { %><span class="status-badge good">On track</span><% } %></td></tr>
<% } } %>
</tbody></table></div></section>
<%@ include file="_layout-bottom.jsp" %>
